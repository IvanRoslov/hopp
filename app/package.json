{
  "name": "hopp-app",
  "private": true,
  "version": "0.0.0",
  "description": "Desktop app for the hopp daemon: sessions, terminals and questions.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build -c cli.vite.config.ts",
    "build:cli": "vite build -c cli.vite.config.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.3.3",
    "electron-vite": "6.0.0",
    "jsdom": "31.0.1",
    "marked": "18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
